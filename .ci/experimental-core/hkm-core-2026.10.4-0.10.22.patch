diff --git a/homeassistant/components/homekit/migration.py b/homeassistant/components/homekit/migration.py
new file mode 100644
index 00000000..20b0e102
--- /dev/null
+++ b/homeassistant/components/homekit/migration.py
@@ -0,0 +1,1031 @@
+"""Core-owned transaction boundary for experimental HomeKit source migration.
+
+This is a deliberately small proof of concept.  The transaction record is
+owned and interpreted by Core; a custom integration cannot inject arbitrary
+callbacks into the HomeKit bootstrap.  Ambiguous records block only the
+matching YAML bridge and never create or remove a bridge automatically.
+"""
+from collections.abc import Mapping
+from dataclasses import dataclass
+import errno
+import hashlib
+import json
+import logging
+import os
+from pathlib import Path
+import signal
+from typing import Any
+
+from homeassistant.config_entries import (
+    SOURCE_IMPORT,
+    SOURCE_USER,
+    ConfigEntry,
+    ConfigEntryState,
+)
+from homeassistant.const import CONF_NAME, CONF_PORT
+from homeassistant.core import HomeAssistant
+from homeassistant.exceptions import HomeAssistantError
+from homeassistant.helpers.storage import Store
+
+from .const import DOMAIN
+
+_LOGGER = logging.getLogger(__name__)
+
+_TEST_FAULT_ENV = "HKM_CORE_MIGRATION_TEST_FAULT"
+_TEST_MODE_ENV = "HKM_CORE_MIGRATION_TEST_MODE"
+
+MIGRATION_SCHEMA_VERSION = 1
+MIGRATION_STORE_VERSION = 1
+MIGRATION_STORE_KEY = "homekit.migration"
+MIGRATION_PROTOCOL_VERSION = 2
+STATES = frozenset(
+    {
+        "PREPARING",
+        "PREPARED",
+        "QUIESCING",
+        "SOURCE_SWITCH_PENDING",
+        "SOURCE_SWITCHED",
+        "RECONCILING",
+        "RELOADING",
+        "VERIFYING",
+        "COMMIT_PENDING",
+        "COMMITTED",
+        "ROLLBACK_PENDING",
+        "ROLLING_BACK",
+        "ROLLBACK_RECONCILING",
+        "ROLLBACK_VERIFYING",
+        "ROLLBACK_COMMIT_PENDING",
+        "ROLLED_BACK",
+        "MANUAL_RECOVERY_REQUIRED",
+    }
+)
+TERMINAL_STATES = frozenset({"COMMITTED", "ROLLED_BACK", "MANUAL_RECOVERY_REQUIRED"})
+COMMIT_STATUSES = frozenset(
+    {
+        "PREPARED",
+        "SOURCE_SWITCH_PENDING",
+        "SOURCE_SWITCHED",
+        "VERIFYING",
+        "COMMIT_PENDING",
+        "COMMITTED",
+        "ROLLBACK_PENDING",
+        "ROLLING_BACK",
+        "ROLLBACK_RECONCILING",
+        "ROLLBACK_VERIFYING",
+        "ROLLBACK_COMMIT_PENDING",
+        "ROLLED_BACK",
+        "MANUAL_RECOVERY_REQUIRED",
+    }
+)
+ALLOWED_TRANSITIONS: dict[str, frozenset[str]] = {
+    "PREPARING": frozenset({"PREPARED", "MANUAL_RECOVERY_REQUIRED"}),
+    "PREPARED": frozenset({"QUIESCING", "SOURCE_SWITCH_PENDING", "MANUAL_RECOVERY_REQUIRED"}),
+    "QUIESCING": frozenset({"SOURCE_SWITCH_PENDING", "ROLLBACK_PENDING", "MANUAL_RECOVERY_REQUIRED"}),
+    "SOURCE_SWITCH_PENDING": frozenset({"SOURCE_SWITCHED", "ROLLBACK_PENDING", "MANUAL_RECOVERY_REQUIRED"}),
+    "SOURCE_SWITCHED": frozenset({"RECONCILING", "VERIFYING", "ROLLBACK_PENDING", "MANUAL_RECOVERY_REQUIRED"}),
+    "RECONCILING": frozenset({"RELOADING", "VERIFYING", "ROLLBACK_PENDING", "MANUAL_RECOVERY_REQUIRED"}),
+    "RELOADING": frozenset({"VERIFYING", "ROLLBACK_PENDING", "MANUAL_RECOVERY_REQUIRED"}),
+    "VERIFYING": frozenset({"COMMIT_PENDING", "ROLLBACK_PENDING", "MANUAL_RECOVERY_REQUIRED"}),
+    "COMMIT_PENDING": frozenset({"COMMITTED", "ROLLBACK_PENDING", "MANUAL_RECOVERY_REQUIRED"}),
+    "ROLLBACK_PENDING": frozenset({"ROLLING_BACK", "MANUAL_RECOVERY_REQUIRED"}),
+    "ROLLING_BACK": frozenset({"ROLLBACK_RECONCILING", "MANUAL_RECOVERY_REQUIRED"}),
+    "ROLLBACK_RECONCILING": frozenset({"ROLLBACK_VERIFYING", "MANUAL_RECOVERY_REQUIRED"}),
+    "ROLLBACK_VERIFYING": frozenset({"ROLLBACK_COMMIT_PENDING", "MANUAL_RECOVERY_REQUIRED"}),
+    "ROLLBACK_COMMIT_PENDING": frozenset({"ROLLED_BACK", "MANUAL_RECOVERY_REQUIRED"}),
+    "COMMITTED": frozenset(),
+    "ROLLED_BACK": frozenset(),
+    "MANUAL_RECOVERY_REQUIRED": frozenset(),
+}
+
+
+class HomeKitMigrationError(HomeAssistantError):
+    """Raised when a Core-owned migration request is not safe."""
+
+
+@dataclass(frozen=True)
+class MigrationObservation:
+    """Result of the pre-reconciliation recovery decision."""
+
+    state: str
+    action: str
+    entry_id: str | None = None
+    reason: str = ""
+    yaml_indices: tuple[int, ...] = ()
+
+    def as_dict(self) -> dict[str, Any]:
+        """Return a JSON-safe status."""
+        return {
+            "schema_version": MIGRATION_SCHEMA_VERSION,
+            "state": self.state,
+            "action": self.action,
+            "entry_id": self.entry_id,
+            "reason": self.reason,
+            "yaml_indices": list(self.yaml_indices),
+        }
+
+
+def _store(hass: HomeAssistant) -> Store[dict[str, Any]]:
+    # The migration record is a write-ahead journal, not ordinary best-effort
+    # integration storage.  HA's atomic writer fsyncs the temporary file before
+    # replacing the journal, so a crash cannot expose a partially serialized
+    # JSON document.  This still does not make ConfigEntry/YAML/HAP a single
+    # cross-store transaction; recovery must verify those stores independently.
+    return Store(
+        hass,
+        MIGRATION_STORE_VERSION,
+        MIGRATION_STORE_KEY,
+        atomic_writes=True,
+    )
+
+
+async def _async_load_recovery_request(
+    hass: HomeAssistant,
+) -> tuple[dict[str, Any] | None, str | None]:
+    """Load the migration journal without Store's corruption recovery.
+
+    The generic Store intentionally renames malformed JSON and returns None so
+    normal Home Assistant startup can continue.  That behavior is unsafe for a
+    migration journal: missing and corrupt are different states.  Recovery
+    therefore performs a strict, read-only envelope check before consulting the
+    Store.  A non-None error means the caller must fail closed and must not
+    overwrite the evidence.
+    """
+    path = Path(_store(hass).path)
+    try:
+        raw = await hass.async_add_executor_job(_read_journal_text, path)
+        envelope = json.loads(raw)
+    except FileNotFoundError:
+        return None, None
+    except (OSError, json.JSONDecodeError, TypeError, ValueError):
+        return None, "Migrationsjournal ist beschädigt oder nicht lesbar"
+
+    if not isinstance(envelope, dict):
+        return None, "Migrationsjournal besitzt keinen gültigen Objekt-Envelope"
+    if envelope.get("version") != MIGRATION_STORE_VERSION:
+        return None, "Unbekannte Migrationsjournal-Version"
+    if envelope.get("key") != MIGRATION_STORE_KEY:
+        return None, "Migrationsjournal-Schlüssel stimmt nicht überein"
+    request = envelope.get("data")
+    if not isinstance(request, dict):
+        return None, "Migrationsjournal enthält keine gültige Transaktion"
+    return request, None
+
+
+def _read_journal_text(path: Path) -> str:
+    """Read the journal through one descriptor without following symlinks."""
+    nofollow = getattr(os, "O_NOFOLLOW", 0)
+    cloexec = getattr(os, "O_CLOEXEC", 0)
+    descriptor = os.open(path, os.O_RDONLY | nofollow | cloexec)
+    try:
+        stat_result = os.fstat(descriptor)
+        if stat_result.st_nlink != 1:
+            raise OSError(errno.EMLINK, "Migrationsjournal ist ein Hardlink")
+        with os.fdopen(descriptor, "r", encoding="utf-8") as file:
+            descriptor = -1
+            return file.read()
+    finally:
+        if descriptor >= 0:
+            os.close(descriptor)
+
+
+def _all_yaml_indices(config: Mapping[str, Any]) -> tuple[int, ...]:
+    """Return every native YAML bridge index when no safe identity is known."""
+    bridges = config.get(DOMAIN)
+    if not isinstance(bridges, list):
+        return ()
+    return tuple(index for index, bridge in enumerate(bridges) if isinstance(bridge, dict))
+
+
+def _maybe_inject_test_fault(point: str) -> None:
+    """Terminate only when an explicitly isolated test requests a fault point."""
+    if (
+        os.environ.get(_TEST_MODE_ENV) == "1"
+        and os.environ.get(_TEST_FAULT_ENV) == point
+    ):
+        os.kill(os.getpid(), signal.SIGKILL)
+
+
+def _maybe_inject_persistence_fault(point: str) -> None:
+    """Raise a controlled I/O error only for isolated Core fault tests."""
+    if (
+        os.environ.get(_TEST_MODE_ENV) != "1"
+        or os.environ.get(_TEST_FAULT_ENV) != point
+    ):
+        return
+    error_name = os.environ.get("HKM_CORE_MIGRATION_TEST_ERRNO", "EIO")
+    error_number = getattr(errno, error_name, errno.EIO)
+    raise OSError(error_number, f"isolated HomeKit migration fault: {error_name}")
+
+
+def _fingerprint(value: Any) -> str:
+    return hashlib.sha256(
+        json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode()
+    ).hexdigest()
+
+
+def _allowlist_fingerprint(allowlist: list[str]) -> str:
+    """Fingerprint the exact positive list, independent of list order."""
+    return _fingerprint(sorted(allowlist))
+
+
+def _entry_allowlist(options: Mapping[str, Any]) -> list[str] | None:
+    """Return an explicit positive list, never treating an empty filter as one."""
+    entity_filter = options.get("filter")
+    if not isinstance(entity_filter, dict):
+        return None
+    allowlist = entity_filter.get("include_entities")
+    if not isinstance(allowlist, list) or not all(isinstance(item, str) for item in allowlist):
+        return None
+    return allowlist
+
+
+def _hap_identity_fingerprint(request: Mapping[str, Any]) -> str:
+    """Fingerprint only non-secret HAP identity inputs owned by the request."""
+    return _fingerprint(
+        {
+            "entry_id": request["entry_id"],
+            "mac": request["mac"],
+            "name": request["name"],
+            "port": request["port"],
+        }
+    )
+
+
+def _hap_pairing_fingerprint(state: Any) -> str:
+    """Fingerprint pairing membership and public controller material only.
+
+    The persisted HAP state contains private bridge keys.  They are deliberately
+    excluded from this fingerprint and from the migration journal.  Pairing
+    membership and the controller public keys are sufficient to detect a lost
+    or replaced controller without copying secrets into Home Assistant storage.
+    """
+    paired_clients = getattr(state, "paired_clients", {}) or {}
+    client_properties = getattr(state, "client_properties", {}) or {}
+    return _fingerprint(
+        {
+            "paired_clients": sorted(
+                (str(client_id), str(public_key))
+                for client_id, public_key in paired_clients.items()
+            ),
+            "client_properties": sorted(
+                (str(client_id), str(properties))
+                for client_id, properties in client_properties.items()
+            ),
+        }
+    )
+
+
+def _transition(request: dict[str, Any], target: str) -> dict[str, Any]:
+    """Apply one validated protocol transition in memory.
+
+    Persistence is deliberately performed by the caller before the associated
+    side effect.  This helper only enforces the state graph and invariants.
+    """
+    current = request["state"]
+    if target not in STATES or target not in ALLOWED_TRANSITIONS.get(current, frozenset()):
+        raise HomeKitMigrationError(f"Ungültiger HomeKit-Transaktionsübergang: {current} -> {target}")
+    request["state"] = target
+    request["commit_status"] = target
+    return request
+
+
+def _normalise_request(request: Mapping[str, Any]) -> dict[str, Any]:
+    """Validate a request and add protocol-v2 fields for legacy journals."""
+    validated = _validate_request(request)
+    protocol_version = validated.get("protocol_version", 1)
+    if protocol_version not in {1, MIGRATION_PROTOCOL_VERSION}:
+        raise HomeKitMigrationError("Unbekannte HomeKit-Migrationsprotokollversion")
+    allowlist = validated["allowlist"]
+    validated.setdefault("protocol_version", MIGRATION_PROTOCOL_VERSION)
+    validated.setdefault("commit_status", validated["state"])
+    validated.setdefault("recovery_generation", 0)
+    validated.setdefault("baseline_revision", validated["baseline_fingerprint"])
+    validated.setdefault(
+        "target_revision",
+        _fingerprint(
+            {
+                "data": validated["target_data"],
+                "options": validated["target_options"],
+            }
+        ),
+    )
+    validated.setdefault("allowlist_fingerprint", _allowlist_fingerprint(allowlist))
+    validated.setdefault("hap_identity_fingerprint", _hap_identity_fingerprint(validated))
+    validated.setdefault("pairing_fingerprint", "")
+    validated.setdefault("hap_accessories_hash", "")
+    baseline_data = validated.get("baseline_data")
+    baseline_options = validated.get("baseline_options")
+    if (baseline_data is None) != (baseline_options is None):
+        raise HomeKitMigrationError("Rollback-Baseline ist unvollständig")
+    if baseline_data is not None:
+        if not isinstance(baseline_data, dict) or not isinstance(baseline_options, dict):
+            raise HomeKitMigrationError("Rollback-Baseline besitzt kein gültiges Format")
+        expected_baseline = _fingerprint(
+            {
+                "entry_id": validated["entry_id"],
+                "source": validated["source"],
+                "data": baseline_data,
+                "options": baseline_options,
+            }
+        )
+        if validated["baseline_fingerprint"] != expected_baseline:
+            raise HomeKitMigrationError("Rollback-Baseline-Prüfsumme stimmt nicht überein")
+        if validated["baseline_revision"] != expected_baseline:
+            raise HomeKitMigrationError("Rollback-Baseline-Revision stimmt nicht überein")
+    expected_target = _fingerprint(
+        {"data": validated["target_data"], "options": validated["target_options"]}
+    )
+    if validated["target_revision"] != expected_target:
+        raise HomeKitMigrationError("Zielkonfigurations-Prüfsumme stimmt nicht überein")
+    if type(validated["recovery_generation"]) is not int or validated["recovery_generation"] < 0:
+        raise HomeKitMigrationError("Ungültige Recovery-Generation")
+    if validated["state"] not in STATES:
+        raise HomeKitMigrationError("Unbekannter HomeKit-Transaktionszustand")
+    if validated["commit_status"] not in COMMIT_STATUSES:
+        raise HomeKitMigrationError("Unbekannter Commit-Status")
+    if validated["state"] != validated["commit_status"]:
+        raise HomeKitMigrationError("Transaktionszustand und Commit-Status sind inkonsistent")
+    if validated["allowlist_fingerprint"] != _allowlist_fingerprint(allowlist):
+        raise HomeKitMigrationError("Allowlist-Prüfsumme stimmt nicht überein")
+    if validated["hap_identity_fingerprint"] != _hap_identity_fingerprint(validated):
+        raise HomeKitMigrationError("HAP-Identitätsprüfsumme stimmt nicht überein")
+    if not isinstance(validated["pairing_fingerprint"], str):
+        raise HomeKitMigrationError("Ungültige HAP-Pairing-Prüfsumme")
+    if not isinstance(validated["hap_accessories_hash"], str):
+        raise HomeKitMigrationError("Ungültige HAP-Accessory-Prüfsumme")
+    if validated["state"] == "COMMITTED" and validated["commit_status"] != "COMMITTED":
+        raise HomeKitMigrationError("Commit wurde ohne Commit-Status markiert")
+    return validated
+
+
+def _validate_request(request: Mapping[str, Any]) -> dict[str, Any]:
+    """Validate an untrusted persisted request before interpreting it."""
+    if request.get("schema_version") != MIGRATION_SCHEMA_VERSION:
+        raise HomeKitMigrationError("Unbekannte HomeKit-Migrationsschema-Version")
+    required = {
+        "transaction_id",
+        "entry_id",
+        "source",
+        "target",
+        "state",
+        "name",
+        "port",
+        "target_data",
+        "target_options",
+        "baseline_fingerprint",
+        "mac",
+        "allowlist",
+    }
+    if not required <= request.keys():
+        raise HomeKitMigrationError("Unvollständiger HomeKit-Migrationsauftrag")
+    if not all(isinstance(request.get(key), str) and request[key] for key in (
+        "transaction_id", "entry_id", "name", "baseline_fingerprint"
+    )):
+        raise HomeKitMigrationError("Ungültige HomeKit-Migrationsidentität")
+    if request["source"] not in {SOURCE_USER, SOURCE_IMPORT}:
+        raise HomeKitMigrationError("Ungültige Ausgangsquelle")
+    if request["target"] not in {SOURCE_USER, SOURCE_IMPORT}:
+        raise HomeKitMigrationError("Ungültige Zielquelle")
+    if request["source"] == request["target"]:
+        raise HomeKitMigrationError("Ausgangs- und Zielquelle sind identisch")
+    if request["state"] not in STATES:
+        raise HomeKitMigrationError("Unbekannter HomeKit-Migrationszustand")
+    if type(request["port"]) is not int or not 1 <= request["port"] <= 65535:
+        raise HomeKitMigrationError("Ungültiger HomeKit-Port")
+    if not isinstance(request["target_data"], dict) or not isinstance(
+        request["target_options"], dict
+    ):
+        raise HomeKitMigrationError("Ungültige Zielkonfiguration")
+    if request["target_data"].get(CONF_NAME, request["name"]) != request["name"]:
+        raise HomeKitMigrationError("Zielname stimmt nicht mit der Bridge-Identität überein")
+    if request["target_data"].get(CONF_PORT, request["port"]) != request["port"]:
+        raise HomeKitMigrationError("Zielport stimmt nicht mit der Bridge-Identität überein")
+    allowlist = request["allowlist"]
+    if not isinstance(allowlist, list) or not all(isinstance(item, str) for item in allowlist):
+        raise HomeKitMigrationError("Ungültige Entitäts-Allowlist")
+    if not isinstance(request["mac"], str) or not request["mac"]:
+        raise HomeKitMigrationError("Ungültige HomeKit-Bridge-MAC")
+    return dict(request)
+
+
+def _matching_yaml_indices(config: Mapping[str, Any], request: Mapping[str, Any]) -> tuple[int, ...]:
+    """Return YAML entries the native importer could associate with this bridge.
+
+    HomeKit's importer matches an imported entry by name *or* port.  Recovery
+    must use the same candidate relation; requiring both fields would leave a
+    stale YAML entry with a changed name and the same port available to create
+    a duplicate bridge after a source switch.
+    """
+    bridges = config.get(DOMAIN)
+    if not isinstance(bridges, list):
+        return ()
+    return tuple(
+        index
+        for index, bridge in enumerate(bridges)
+        if isinstance(bridge, dict)
+        and (
+            bridge.get(CONF_NAME, request["name"]) == request["name"]
+            or bridge.get(CONF_PORT, request["port"]) == request["port"]
+        )
+    )
+
+
+def filter_yaml_for_observation(
+    config: Mapping[str, Any], observation: MigrationObservation
+) -> dict[str, Any]:
+    """Remove only the transaction's matching YAML bridge from reconciliation."""
+    if not observation.yaml_indices or DOMAIN not in config:
+        return dict(config)
+    bridges = config[DOMAIN]
+    if not isinstance(bridges, list):
+        return dict(config)
+    blocked = set(observation.yaml_indices)
+    result = dict(config)
+    result[DOMAIN] = [bridge for index, bridge in enumerate(bridges) if index not in blocked]
+    return result
+
+
+async def async_prepare_source_migration(
+    hass: HomeAssistant, request: Mapping[str, Any]
+) -> dict[str, Any]:
+    """Persist a validated Core-owned migration request before side effects."""
+    validated = _normalise_request(request)
+    if validated["state"] != "PREPARED":
+        raise HomeKitMigrationError("Prepare benötigt den Zustand PREPARED")
+    entry = hass.config_entries.async_get_entry(validated["entry_id"])
+    if entry is None or entry.domain != DOMAIN:
+        raise HomeKitMigrationError("HomeKit-Config-Entry nicht gefunden")
+    if entry.source != validated["source"]:
+        raise HomeKitMigrationError("HomeKit-Quelle hat sich seit dem Preflight geändert")
+    if entry.data.get(CONF_NAME) != validated["name"] or entry.data.get(CONF_PORT) != validated["port"]:
+        raise HomeKitMigrationError("HomeKit-Bridge-Identität hat sich seit dem Preflight geändert")
+    validated["baseline_fingerprint"] = _fingerprint(
+        {
+            "entry_id": entry.entry_id,
+            "source": entry.source,
+            "data": dict(entry.data),
+            "options": dict(entry.options),
+        }
+    )
+    validated["baseline_revision"] = validated["baseline_fingerprint"]
+    validated["baseline_data"] = dict(entry.data)
+    validated["baseline_options"] = dict(entry.options)
+    validated["target_revision"] = _fingerprint(
+        {
+            "data": validated["target_data"],
+            "options": validated["target_options"],
+        }
+    )
+    validated["allowlist_fingerprint"] = _allowlist_fingerprint(validated["allowlist"])
+    validated["hap_identity_fingerprint"] = _hap_identity_fingerprint(validated)
+    homekit = getattr(getattr(entry, "runtime_data", None), "homekit", None)
+    driver = getattr(homekit, "driver", None)
+    if driver is None:
+        raise HomeKitMigrationError("HAP-Treiber ist für den Identitäts-Snapshot nicht verfügbar")
+    validated["pairing_fingerprint"] = _hap_pairing_fingerprint(driver.state)
+    validated["hap_accessories_hash"] = str(driver.state.accessories_hash or "")
+    _normalise_request(validated)
+    _maybe_inject_persistence_fault("BEFORE_MIGRATION_JOURNAL_WRITE")
+    await _store(hass).async_save(validated)
+    _maybe_inject_test_fault("AFTER_PREPARE_DURABLE")
+    return {"state": validated["state"], "transaction_id": validated["transaction_id"], "entry_id": entry.entry_id}
+
+
+async def async_switch_source(hass: HomeAssistant, transaction_id: str) -> ConfigEntry:
+    """Apply the source mutation through the Core-owned API."""
+    request, load_error = await _async_load_recovery_request(hass)
+    if load_error:
+        raise HomeKitMigrationError(load_error)
+    if not isinstance(request, dict) or request.get("transaction_id") != transaction_id:
+        raise HomeKitMigrationError("Unbekannter HomeKit-Migrationsauftrag")
+    request = _normalise_request(request)
+    entry = hass.config_entries.async_get_entry(request["entry_id"])
+    if entry is None:
+        raise HomeKitMigrationError("HomeKit-Entry ist nicht vorhanden")
+    if request["state"] == "SOURCE_SWITCHED" and entry.source == request["target"]:
+        return entry
+    if request["state"] != "PREPARED" or entry.source != request["source"]:
+        raise HomeKitMigrationError("HomeKit-Entry ist nicht im erwarteten Ausgangszustand")
+    if entry.state is ConfigEntryState.LOADED:
+        raise HomeKitMigrationError("HomeKit-Entry muss vor der Quellenmutation entladen sein")
+    _transition(request, "SOURCE_SWITCH_PENDING")
+    await _store(hass).async_save(request)
+    _maybe_inject_test_fault("AFTER_SOURCE_SWITCH_PENDING")
+    # Persist the complete target entry before changing ``source``.  If the
+    # process dies between these two durable saves, startup sees the original
+    # source and deliberately blocks instead of guessing.
+    hass.config_entries.async_update_entry(
+        entry,
+        data=request["target_data"],
+        options=request["target_options"],
+    )
+    hass.config_entries.async_update_entry_source(entry, source=request["target"])
+    # ConfigEntries normally debounces writes.  A source switch is a recovery
+    # boundary, so the Core transaction must force the current entry set to
+    # storage before the process can continue to unload/reload the bridge.
+    await hass.config_entries._store.async_save(  # noqa: SLF001
+        hass.config_entries._data_to_save()  # noqa: SLF001
+    )
+    _transition(request, "SOURCE_SWITCHED")
+    await _store(hass).async_save(request)
+    _maybe_inject_test_fault("AFTER_SOURCE_SWITCH_DURABLE")
+    return entry
+
+
+async def _async_rollback_manual(
+    hass: HomeAssistant, request: dict[str, Any], reason: str
+) -> dict[str, Any]:
+    """Persist a terminal safety decision without guessing at a repair."""
+    if request["state"] not in TERMINAL_STATES:
+        _transition(request, "MANUAL_RECOVERY_REQUIRED")
+        request["recovery_generation"] += 1
+        request["recovery_reason"] = reason
+        await _store(hass).async_save(request)
+    return {
+        "state": "MANUAL_RECOVERY_REQUIRED",
+        "action": "manual_recovery",
+        "entry_id": request.get("entry_id"),
+        "reason": reason,
+    }
+
+
+async def _async_execute_rollback(
+    hass: HomeAssistant, request: dict[str, Any]
+) -> dict[str, Any]:
+    """Restore the exact baseline entry, then leave HAP verification to setup."""
+    if request["state"] == "ROLLBACK_PENDING":
+        _transition(request, "ROLLING_BACK")
+        await _store(hass).async_save(request)
+
+    if request["state"] not in {
+        "ROLLING_BACK",
+        "ROLLBACK_RECONCILING",
+        "ROLLBACK_VERIFYING",
+        "ROLLBACK_COMMIT_PENDING",
+    }:
+        return await _async_rollback_manual(
+            hass, request, "Rollback ist in diesem Transaktionszustand nicht zulässig"
+        )
+
+    entry = hass.config_entries.async_get_entry(request["entry_id"])
+    baseline_data = request.get("baseline_data")
+    baseline_options = request.get("baseline_options")
+    if entry is None or not isinstance(baseline_data, dict) or not isinstance(baseline_options, dict):
+        return await _async_rollback_manual(
+            hass, request, "Rollback-Baseline oder Config Entry fehlt"
+        )
+
+    expected_allowlist = request["allowlist_fingerprint"]
+    current_allowlist = _entry_allowlist(entry.options)
+    baseline_allowlist = _entry_allowlist(baseline_options)
+    if (
+        current_allowlist is None
+        or baseline_allowlist is None
+        or _allowlist_fingerprint(current_allowlist) != expected_allowlist
+        or _allowlist_fingerprint(baseline_allowlist) != expected_allowlist
+    ):
+        return await _async_rollback_manual(
+            hass, request, "Rollback-Allowlist ist nicht eindeutig verifizierbar"
+        )
+
+    baseline_matches = (
+        entry.source == request["source"]
+        and dict(entry.data) == baseline_data
+        and dict(entry.options) == baseline_options
+    )
+    target_matches = (
+        entry.source == request["target"]
+        and dict(entry.data) == request["target_data"]
+        and dict(entry.options) == request["target_options"]
+    )
+    if not baseline_matches and not target_matches:
+        return await _async_rollback_manual(
+            hass, request, "Config Entry ist weder im Ziel- noch im Baselinezustand"
+        )
+
+    if target_matches:
+        _maybe_inject_test_fault("BEFORE_ROLLBACK_SOURCE_MUTATION")
+        _maybe_inject_persistence_fault("BEFORE_ROLLBACK_CONFIG_ENTRY_WRITE")
+        hass.config_entries.async_update_entry(
+            entry, data=baseline_data, options=baseline_options
+        )
+        hass.config_entries.async_update_entry_source(entry, source=request["source"])
+        await hass.config_entries._store.async_save(  # noqa: SLF001
+            hass.config_entries._data_to_save()  # noqa: SLF001
+        )
+        _maybe_inject_test_fault("AFTER_ROLLBACK_SOURCE_MUTATION")
+
+    if request["state"] == "ROLLING_BACK":
+        _maybe_inject_test_fault("BEFORE_ROLLBACK_RECONCILIATION")
+        _transition(request, "ROLLBACK_RECONCILING")
+        await _store(hass).async_save(request)
+        _maybe_inject_test_fault("AFTER_ROLLBACK_RECONCILIATION")
+
+    return {
+        "state": request["state"],
+        "action": "rollback_verify_after_setup",
+        "entry_id": entry.entry_id,
+        "source": entry.source,
+    }
+
+
+async def async_request_rollback(
+    hass: HomeAssistant, transaction_id: str, reason: str
+) -> dict[str, Any]:
+    """Durably request and execute rollback for an unfinished transaction."""
+    request, load_error = await _async_load_recovery_request(hass)
+    if load_error:
+        raise HomeKitMigrationError(load_error)
+    if not isinstance(request, dict) or request.get("transaction_id") != transaction_id:
+        raise HomeKitMigrationError("Unbekannter HomeKit-Rollbackauftrag")
+    request = _normalise_request(request)
+    if request["state"] == "COMMITTED":
+        return {"state": "COMMITTED", "action": "none", "reason": "Commit ist dauerhaft abgeschlossen"}
+    if request["state"] == "ROLLED_BACK":
+        return {"state": "ROLLED_BACK", "action": "none", "reason": "Rollback ist bereits abgeschlossen"}
+    if request["state"] == "MANUAL_RECOVERY_REQUIRED":
+        return {"state": request["state"], "action": "manual_recovery"}
+    if request["state"] not in ALLOWED_TRANSITIONS or "ROLLBACK_PENDING" not in ALLOWED_TRANSITIONS[request["state"]]:
+        return await _async_rollback_manual(
+            hass, request, "Rollback kann aus diesem Zustand nicht sicher gestartet werden"
+        )
+    _maybe_inject_test_fault("BEFORE_ROLLBACK_PENDING")
+    _transition(request, "ROLLBACK_PENDING")
+    request["rollback_reason"] = reason
+    await _store(hass).async_save(request)
+    _maybe_inject_test_fault("AFTER_ROLLBACK_PENDING")
+    return await _async_execute_rollback(hass, request)
+
+
+async def async_finalize_after_rollback(
+    hass: HomeAssistant,
+    entry: ConfigEntry,
+    mac: str | None,
+    pairing_fingerprint: str | None,
+    accessories_hash: str | None,
+) -> None:
+    """Verify the restored HAP runtime before writing ROLLED_BACK."""
+    request, load_error = await _async_load_recovery_request(hass)
+    if load_error or not isinstance(request, dict):
+        return
+    try:
+        request = _normalise_request(request)
+    except HomeKitMigrationError as err:
+        _LOGGER.error("HomeKit-Rollback bleibt blockiert: %s", err)
+        return
+    if request["state"] not in {
+        "ROLLBACK_RECONCILING",
+        "ROLLBACK_VERIFYING",
+        "ROLLBACK_COMMIT_PENDING",
+    }:
+        return
+    if entry.entry_id != request["entry_id"] or entry.source != request["source"]:
+        await _async_rollback_manual(hass, request, "Rollback-Entry oder Quelle stimmt nicht")
+        return
+    if dict(entry.data) != request.get("baseline_data") or dict(entry.options) != request.get("baseline_options"):
+        await _async_rollback_manual(hass, request, "Rollback-Konfiguration stimmt nicht mit der Baseline überein")
+        return
+    current_allowlist = _entry_allowlist(entry.options)
+    if current_allowlist is None or _allowlist_fingerprint(current_allowlist) != request["allowlist_fingerprint"]:
+        await _async_rollback_manual(hass, request, "Rollback-Allowlist stimmt nicht mit der Baseline überein")
+        return
+    _maybe_inject_test_fault("BEFORE_ROLLBACK_HAP_VERIFY")
+    if mac != request["mac"]:
+        await _async_rollback_manual(hass, request, "Rollback-HAP-MAC stimmt nicht mit der Baseline überein")
+        return
+    if pairing_fingerprint != request["pairing_fingerprint"]:
+        await _async_rollback_manual(
+            hass, request, "Rollback-HAP-Pairing stimmt nicht mit der Baseline überein"
+        )
+        return
+    if accessories_hash != request["hap_accessories_hash"]:
+        await _async_rollback_manual(
+            hass, request, "Rollback-HAP-Accessory-Struktur stimmt nicht mit der Baseline überein"
+        )
+        return
+    if request["state"] == "ROLLBACK_RECONCILING":
+        _transition(request, "ROLLBACK_VERIFYING")
+        await _store(hass).async_save(request)
+        _maybe_inject_test_fault("AFTER_ROLLBACK_HAP_VERIFY")
+    if request["state"] == "ROLLBACK_VERIFYING":
+        _maybe_inject_test_fault("BEFORE_ROLLBACK_COMMIT")
+        _transition(request, "ROLLBACK_COMMIT_PENDING")
+        await _store(hass).async_save(request)
+    if request["state"] == "ROLLBACK_COMMIT_PENDING":
+        _transition(request, "ROLLED_BACK")
+        await _store(hass).async_save(request)
+        _maybe_inject_test_fault("AFTER_ROLLBACK_COMMIT")
+
+
+async def async_validate_before_hap_publish(
+    hass: HomeAssistant,
+    entry: ConfigEntry,
+    mac: str | None,
+    pairing_fingerprint: str,
+    accessories_hash: str,
+) -> bool:
+    """Reject a mutated transaction before the bridge advertises on HAP.
+
+    This is intentionally called after the driver has loaded persisted state and
+    the in-memory accessory graph has been built, but before the bridge is
+    registered or the HAP driver is started.  Other bridges are not affected by
+    a transaction belonging to a different entry.
+    """
+    request, load_error = await _async_load_recovery_request(hass)
+    if load_error or not isinstance(request, dict):
+        return load_error is None
+    try:
+        request = _normalise_request(request)
+    except HomeKitMigrationError:
+        return False
+    if request["state"] == "MANUAL_RECOVERY_REQUIRED":
+        # A validated transaction identity scopes a damaged bridge.  Other
+        # Config Entries must remain startable; an unreadable journal has no
+        # identity and is handled conservatively by async_setup instead.
+        return entry.entry_id != request["entry_id"]
+    if request["state"] in TERMINAL_STATES:
+        return True
+    if (
+        entry.entry_id != request["entry_id"]
+        and (
+            entry.data.get(CONF_NAME) != request["name"]
+            or entry.data.get(CONF_PORT) != request["port"]
+        )
+    ):
+        return True
+
+    duplicate_entries = [
+        candidate
+        for candidate in hass.config_entries.async_entries(DOMAIN)
+        if candidate.entry_id != entry.entry_id
+        and candidate.data.get(CONF_NAME) == entry.data.get(CONF_NAME)
+        and candidate.data.get(CONF_PORT) == entry.data.get(CONF_PORT)
+    ]
+    if duplicate_entries:
+        await _async_rollback_manual(
+            hass, request, "Mehrere HomeKit-Config-Entries besitzen dieselbe Bridge-Identität"
+        )
+        return False
+
+    rollback_states = {
+        "ROLLBACK_PENDING",
+        "ROLLING_BACK",
+        "ROLLBACK_RECONCILING",
+        "ROLLBACK_VERIFYING",
+        "ROLLBACK_COMMIT_PENDING",
+    }
+    expected_source = request["source"] if request["state"] in rollback_states else request["target"]
+    expected_data = request.get("baseline_data") if request["state"] in rollback_states else request["target_data"]
+    expected_options = request.get("baseline_options") if request["state"] in rollback_states else request["target_options"]
+    if (
+        entry.source != expected_source
+        or not isinstance(expected_data, dict)
+        or not isinstance(expected_options, dict)
+        or dict(entry.data) != expected_data
+        or dict(entry.options) != expected_options
+    ):
+        await _async_rollback_manual(hass, request, "Config Entry ist vor HAP-Start nicht im erwarteten Transaktionszustand")
+        return False
+    if mac != request["mac"]:
+        await _async_rollback_manual(hass, request, "HAP-MAC stimmt vor HAP-Start nicht mit der Baseline überein")
+        return False
+    if pairing_fingerprint != request["pairing_fingerprint"]:
+        await _async_rollback_manual(hass, request, "HAP-Pairing stimmt vor HAP-Start nicht mit der Baseline überein")
+        return False
+    if accessories_hash != request["hap_accessories_hash"]:
+        await _async_rollback_manual(
+            hass, request, "HAP-Accessory-Struktur stimmt vor HAP-Start nicht mit der Baseline überein"
+        )
+        return False
+    return True
+
+
+async def async_recover_before_yaml_reconciliation(
+    hass: HomeAssistant, config: Mapping[str, Any]
+) -> MigrationObservation:
+    """Recover or block one pending transaction before the YAML importer runs."""
+    request, load_error = await _async_load_recovery_request(hass)
+    if load_error:
+        # No transaction identity can be trusted.  Block all native YAML
+        # reconciliation rather than allowing a potentially duplicate bridge.
+        # Do not write the corrupt file or manufacture a replacement journal.
+        return MigrationObservation(
+            "MANUAL_RECOVERY_REQUIRED",
+            "manual_recovery",
+            reason=load_error,
+            yaml_indices=_all_yaml_indices(config),
+        )
+    if request is None:
+        return MigrationObservation("IDLE", "none", reason="Kein HomeKit-Migrationsauftrag")
+    if not isinstance(request, dict):
+        return MigrationObservation("UNKNOWN", "manual_recovery", reason="Beschädigter HomeKit-Migrationsauftrag")
+    try:
+        request = _normalise_request(request)
+    except HomeKitMigrationError as err:
+        return MigrationObservation(
+            "MANUAL_RECOVERY_REQUIRED",
+            "manual_recovery",
+            reason=str(err),
+            yaml_indices=_all_yaml_indices(config),
+        )
+
+    if request["state"] in {
+        "ROLLBACK_PENDING",
+        "ROLLING_BACK",
+        "ROLLBACK_RECONCILING",
+        "ROLLBACK_VERIFYING",
+        "ROLLBACK_COMMIT_PENDING",
+    }:
+        result = await _async_execute_rollback(hass, request)
+        if result["action"] == "manual_recovery":
+            return MigrationObservation(
+                "MANUAL_RECOVERY_REQUIRED",
+                "manual_recovery",
+                request["entry_id"],
+                result.get("reason", "Rollback blockiert"),
+                _all_yaml_indices(config),
+            )
+        indices = (
+            _matching_yaml_indices(config, request)
+            if request["source"] == SOURCE_USER
+            else ()
+        )
+        if len(indices) > 1:
+            await _async_rollback_manual(
+                hass, request, "Mehrere YAML-Bridges für den Rollback-Zielzustand"
+            )
+            return MigrationObservation(
+                "MANUAL_RECOVERY_REQUIRED",
+                "manual_recovery",
+                request["entry_id"],
+                "Mehrere YAML-Bridges für den Rollback-Zielzustand",
+                indices,
+            )
+        return MigrationObservation(
+            result["state"],
+            "rollback_verify_after_setup",
+            request["entry_id"],
+            "Rollback-Baseline ist persistiert; HAP-Verifikation ausstehend",
+            indices,
+        )
+
+    async def manual(reason: str, entry_id: str | None, indices: tuple[int, ...]) -> MigrationObservation:
+        request["state"] = "MANUAL_RECOVERY_REQUIRED"
+        request["commit_status"] = "MANUAL_RECOVERY_REQUIRED"
+        request["recovery_generation"] += 1
+        request["recovery_reason"] = reason
+        await _store(hass).async_save(request)
+        return MigrationObservation("MANUAL_RECOVERY_REQUIRED", "manual_recovery", entry_id, reason, indices)
+
+    indices = _matching_yaml_indices(config, request)
+    if request["state"] in TERMINAL_STATES:
+        if request["state"] == "ROLLED_BACK" and request["source"] == SOURCE_USER:
+            return MigrationObservation(
+                "ROLLED_BACK",
+                "none",
+                request["entry_id"],
+                "Rollback ist abgeschlossen; passende YAML-Definition wird unterdrückt",
+                indices,
+            )
+        if request["target"] == SOURCE_USER and indices:
+            return MigrationObservation(
+                "MANUAL_RECOVERY_REQUIRED",
+                "manual_recovery",
+                request["entry_id"],
+                "Abgeschlossene UI-Migration hat noch eine passende YAML-Definition",
+                indices,
+            )
+        return MigrationObservation(request["state"], "none", request["entry_id"], "Transaktion ist abgeschlossen")
+    entry = hass.config_entries.async_get_entry(request["entry_id"])
+    if len(indices) > 1:
+        return await manual("Mehrere passende YAML-Bridges; Zuordnung ist nicht eindeutig", request["entry_id"], indices)
+    if entry is None:
+        return await manual("Betroffene HomeKit-Config-Entry fehlt", request["entry_id"], indices)
+    if entry.source == request["target"]:
+        expected = {
+            "data": request["target_data"],
+            "options": request["target_options"],
+        }
+        if _fingerprint(expected) != _fingerprint(
+            {"data": dict(entry.data), "options": dict(entry.options)}
+        ):
+            return await manual("Zielkonfiguration ist nicht vollständig persistiert", entry.entry_id, indices)
+        current_filter = entry.options.get("filter", {})
+        current_allowlist = current_filter.get("include_entities") if isinstance(current_filter, dict) else None
+        if not isinstance(current_allowlist, list) or _allowlist_fingerprint(current_allowlist) != request["allowlist_fingerprint"]:
+            return await manual("Allowlist ist nach dem Quellenwechsel nicht identisch", entry.entry_id, indices)
+        if request["state"] == "SOURCE_SWITCH_PENDING":
+            _transition(request, "SOURCE_SWITCHED")
+            await _store(hass).async_save(request)
+        if request["state"] != "COMMIT_PENDING":
+            if request["state"] != "VERIFYING":
+                _transition(request, "VERIFYING")
+            request["recovery_generation"] += 1
+        request["commit_status"] = request["state"]
+        await _store(hass).async_save(request)
+        _maybe_inject_test_fault("DURING_RECOVERY")
+        return MigrationObservation("VERIFYING", "verify_after_setup", entry.entry_id, "Quellenwechsel ist persistiert", indices)
+    if entry.source == request["source"]:
+        if not isinstance(request.get("baseline_data"), dict) or not isinstance(
+            request.get("baseline_options"), dict
+        ):
+            return await manual("Baseline-Konfiguration für eine sichere Recovery fehlt", entry.entry_id, indices)
+        if _fingerprint(
+            {"data": request["baseline_data"], "options": request["baseline_options"]}
+        ) != _fingerprint({"data": dict(entry.data), "options": dict(entry.options)}):
+            return await manual("Ausgangskonfiguration hat sich seit dem Preflight geändert", entry.entry_id, indices)
+        return await manual("Quellenwechsel wurde vor dem persistierten Source-Switch unterbrochen", entry.entry_id, indices)
+    return await manual("Config-Entry-Quelle ist weder Ausgangs- noch Zielquelle", entry.entry_id, indices)
+
+
+async def async_finalize_after_setup(
+    hass: HomeAssistant,
+    entry: ConfigEntry,
+    mac: str | None,
+    pairing_fingerprint: str | None,
+    accessories_hash: str | None,
+) -> None:
+    """Finalize an automatically recovered transaction after HAP setup."""
+    request, load_error = await _async_load_recovery_request(hass)
+    if load_error or not isinstance(request, dict):
+        if load_error:
+            _LOGGER.error("HomeKit-Migration bleibt blockiert: %s", load_error)
+        return
+    try:
+        request = _normalise_request(request)
+    except HomeKitMigrationError as err:
+        _LOGGER.error("HomeKit-Migration bleibt blockiert: %s", err)
+        return
+    if request.get("state") not in {"VERIFYING", "COMMIT_PENDING"}:
+        return
+    if entry.entry_id != request["entry_id"] or entry.source != request["target"]:
+        request["state"] = "MANUAL_RECOVERY_REQUIRED"
+        request["commit_status"] = "MANUAL_RECOVERY_REQUIRED"
+        await _store(hass).async_save(request)
+        return
+    expected_mac = request.get("mac")
+    if expected_mac != mac:
+        request["state"] = "MANUAL_RECOVERY_REQUIRED"
+        request["commit_status"] = "MANUAL_RECOVERY_REQUIRED"
+        await _store(hass).async_save(request)
+        _LOGGER.error("HomeKit-MAC stimmt nach Recovery nicht mit der Baseline überein")
+        return
+    if pairing_fingerprint != request["pairing_fingerprint"]:
+        request["state"] = "MANUAL_RECOVERY_REQUIRED"
+        request["commit_status"] = "MANUAL_RECOVERY_REQUIRED"
+        await _store(hass).async_save(request)
+        _LOGGER.error("HomeKit-Pairing stimmt nach Recovery nicht mit der Baseline überein")
+        return
+    if accessories_hash != request["hap_accessories_hash"]:
+        request["state"] = "MANUAL_RECOVERY_REQUIRED"
+        request["commit_status"] = "MANUAL_RECOVERY_REQUIRED"
+        await _store(hass).async_save(request)
+        _LOGGER.error("HomeKit-Accessory-Struktur stimmt nach Recovery nicht mit der Baseline überein")
+        return
+    if request["state"] == "VERIFYING":
+        _transition(request, "COMMIT_PENDING")
+        await _store(hass).async_save(request)
+        _maybe_inject_test_fault("AFTER_COMMIT_PENDING")
+    _transition(request, "COMMITTED")
+    await _store(hass).async_save(request)
+
+
+async def async_get_migration_status(hass: HomeAssistant) -> dict[str, Any]:
+    """Return a read-only, normalized protocol status for administrators."""
+    request, load_error = await _async_load_recovery_request(hass)
+    if load_error:
+        return {
+            "protocol_version": MIGRATION_PROTOCOL_VERSION,
+            "state": "MANUAL_RECOVERY_REQUIRED",
+            "action": "manual_recovery",
+            "reason": load_error,
+        }
+    if request is None:
+        return {
+            "protocol_version": MIGRATION_PROTOCOL_VERSION,
+            "state": "IDLE",
+            "action": "none",
+        }
+    try:
+        normalized = _normalise_request(request)
+    except HomeKitMigrationError as err:
+        return {
+            "protocol_version": MIGRATION_PROTOCOL_VERSION,
+            "state": "MANUAL_RECOVERY_REQUIRED",
+            "action": "manual_recovery",
+            "reason": str(err),
+        }
+    return {
+        "protocol_version": normalized["protocol_version"],
+        "transaction_id": normalized["transaction_id"],
+        "entry_id": normalized["entry_id"],
+        "source": normalized["source"],
+        "target": normalized["target"],
+        "state": normalized["state"],
+        "commit_status": normalized["commit_status"],
+        "recovery_generation": normalized["recovery_generation"],
+        "baseline_revision": normalized["baseline_revision"],
+        "target_revision": normalized["target_revision"],
+        "allowlist_fingerprint": normalized["allowlist_fingerprint"],
+        "hap_identity_fingerprint": normalized["hap_identity_fingerprint"],
+    }
