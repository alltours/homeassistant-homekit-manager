diff --git a/tests/components/homekit/test_migration.py b/tests/components/homekit/test_migration.py
new file mode 100644
index 00000000..c2ed2eb3
--- /dev/null
+++ b/tests/components/homekit/test_migration.py
@@ -0,0 +1,149 @@
+"""Tests for the experimental Core-owned HomeKit migration boundary."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from homeassistant.components.homekit.migration import (
+    HomeKitMigrationError,
+    MigrationObservation,
+    _all_yaml_indices,
+    _matching_yaml_indices,
+    _normalise_request,
+    _store,
+    _transition,
+    _validate_request,
+    filter_yaml_for_observation,
+)
+from homeassistant.config_entries import SOURCE_IMPORT, SOURCE_USER
+
+
+def _request() -> dict:
+    return {
+        "schema_version": 1,
+        "transaction_id": "transaction-1",
+        "entry_id": "entry-1",
+        "source": SOURCE_USER,
+        "target": SOURCE_IMPORT,
+        "state": "PREPARED",
+        "name": "Test Bridge",
+        "port": 22111,
+        "target_data": {"name": "Test Bridge", "port": 22111},
+        "target_options": {"mode": "bridge", "filter": {"include_entities": ["light.test"]}},
+        "baseline_fingerprint": "baseline",
+        "mac": "AA:BB:CC:DD:EE:FF",
+        "allowlist": ["light.test"],
+    }
+
+
+def test_request_validation_accepts_only_core_sources() -> None:
+    """Reject source values that Core does not own."""
+    assert _validate_request(_request())["entry_id"] == "entry-1"
+    invalid = _request()
+    invalid["target"] = "unsupported"
+    with pytest.raises(HomeKitMigrationError):
+        _validate_request(invalid)
+
+
+def test_yaml_filter_blocks_only_matching_transaction_bridge() -> None:
+    """Filter only the bridge named by the pending transaction."""
+    config = {
+        "homekit": [
+            {"name": "Test Bridge", "port": 22111},
+            {"name": "Other Bridge", "port": 22112},
+        ]
+    }
+    observation = MigrationObservation("VERIFYING", "verify_after_setup", "entry-1", yaml_indices=(0,))
+    filtered = filter_yaml_for_observation(config, observation)
+    assert filtered["homekit"] == [{"name": "Other Bridge", "port": 22112}]
+    assert config["homekit"][0]["name"] == "Test Bridge"
+
+
+def test_yaml_candidate_matching_covers_native_port_matching() -> None:
+    """A renamed stale YAML bridge on the same port must be quarantined."""
+    config = {
+        "homekit": [
+            {"name": "Renamed Bridge", "port": 22111},
+            {"name": "Other Bridge", "port": 22112},
+        ]
+    }
+    assert _matching_yaml_indices(config, _request()) == (0,)
+
+
+def test_empty_observation_is_read_only() -> None:
+    """Leave YAML untouched when there is no pending transaction."""
+    config = {"homekit": [{"name": "Test Bridge", "port": 22111}]}
+    assert filter_yaml_for_observation(config, MigrationObservation("IDLE", "none")) == config
+
+
+def test_unknown_journal_identity_can_block_all_yaml_bridges() -> None:
+    """Unknown journal data must not permit ambiguous YAML reconciliation."""
+    config = {
+        "homekit": [
+            {"name": "Bridge A", "port": 22111},
+            {"name": "Bridge B", "port": 22112},
+            "invalid-entry",
+        ]
+    }
+    assert _all_yaml_indices(config) == (0, 1)
+
+
+def test_protocol_v2_normalises_identity_and_allowlist_fingerprints() -> None:
+    """New transactions carry explicit non-secret recovery fingerprints."""
+    request = _normalise_request(_request())
+    assert request["protocol_version"] == 2
+    assert request["commit_status"] == "PREPARED"
+    assert len(request["allowlist_fingerprint"]) == 64
+    assert len(request["hap_identity_fingerprint"]) == 64
+
+
+def test_protocol_rejects_tampered_persisted_baseline() -> None:
+    """A changed rollback payload cannot pass the journal envelope checks."""
+    request = _normalise_request(_request())
+    request["baseline_data"] = {"name": "Different Bridge", "port": 22111}
+    request["baseline_options"] = dict(request["target_options"])
+    with pytest.raises(HomeKitMigrationError, match="Baseline-Prüfsumme"):
+        _normalise_request(request)
+
+
+def test_protocol_rejects_tampered_target_revision() -> None:
+    """A stale target revision cannot authorize a different target payload."""
+    request = _normalise_request(_request())
+    request["target_options"] = {"mode": "bridge", "filter": {"include_entities": []}}
+    with pytest.raises(HomeKitMigrationError, match="Zielkonfigurations-Prüfsumme"):
+        _normalise_request(request)
+
+
+def test_protocol_rejects_invalid_transition() -> None:
+    """A terminal commit cannot be reopened by recovery code."""
+    request = _normalise_request(_request())
+    _transition(request, "SOURCE_SWITCH_PENDING")
+    _transition(request, "SOURCE_SWITCHED")
+    _transition(request, "VERIFYING")
+    _transition(request, "COMMIT_PENDING")
+    _transition(request, "COMMITTED")
+    with pytest.raises(HomeKitMigrationError, match="Transaktionsübergang"):
+        _transition(request, "ROLLBACK_PENDING")
+
+
+def test_protocol_journal_uses_atomic_store_writes(tmp_path) -> None:
+    """The Core-owned WAL must use HA's fsync-backed atomic writer."""
+    hass = SimpleNamespace(
+        data={}, config=SimpleNamespace(config_dir=str(tmp_path))
+    )
+    assert _store(hass)._atomic_writes is True
+
+
+def test_rollback_state_graph_is_forward_only() -> None:
+    """Rollback has durable pending, verify and commit boundaries."""
+    request = _normalise_request(_request())
+    _transition(request, "SOURCE_SWITCH_PENDING")
+    _transition(request, "SOURCE_SWITCHED")
+    _transition(request, "ROLLBACK_PENDING")
+    _transition(request, "ROLLING_BACK")
+    _transition(request, "ROLLBACK_RECONCILING")
+    _transition(request, "ROLLBACK_VERIFYING")
+    _transition(request, "ROLLBACK_COMMIT_PENDING")
+    _transition(request, "ROLLED_BACK")
+    with pytest.raises(HomeKitMigrationError, match="Transaktionsübergang"):
+        _transition(request, "ROLLBACK_PENDING")
