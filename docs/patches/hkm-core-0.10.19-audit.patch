+def test_protocol_rejects_tampered_persisted_baseline() -> None:
+    """A changed rollback payload cannot pass the journal envelope checks."""
+    request = _normalise_request(_request())
+    request["baseline_data"] = {"name": "Different Bridge", "port": 22111}
+    request["baseline_options"] = dict(request["target_options"])
+    with pytest.raises(HomeKitMigrationError, match="Baseline-Prüfsumme"):
+        _normalise_request(request)
+
